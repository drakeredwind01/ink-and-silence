digraph MBTI_Compatibility {
    // System Architecture Configuration
    rankdir=LR;
    splines=true;
    node [shape=box, style="rounded,filled", fontname="Arial", fontsize=11];
    edge [fontname="Arial", fontsize=9, color="#7f8c8d"];

    // --- NODE STYLING & CORE GROUPS ---
    
    // Core Subject (Right Hub)
    ENTJ [label="ENTJ\n'The Commander'\n(Te-Ni-Se-Fi)", fillcolor="#2c3e50", fontcolor="white", width=1.5];

    // High Compatibility Tier (Analytical / Complementary)
    node [fillcolor="#ecf0f1", fontcolor="#2c3e50", color="#bdc3c7"];
    INTP [label="INTP\n'The Thinker'\n(Ti-Ne-Si-Fe)"];
    INFP [label="INFP\n'The Mediator'\n(Fi-Ne-Si-Te)"];
    INTJ [label="INTJ\n'The Architect'\n(Ni-Te-Fi-Se)"];

    // Growth Tier (High Risk / High Reward)
    node [fillcolor="#fff2cc", fontcolor="#7f6000", color="#d6b656"];
    ISFP [label="ISFP\n'The Artist'\n(Fi-Se-Ni-Te)"];

    // Character / Archetype Anchors (Left Input)
    node [fillcolor="#e8f8f5", fontcolor="#117a65", color="#a3e4d7"];
    Starfire [
        shape=plaintext,
        label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD FIXEDSIZE="TRUE" WIDTH="80" HEIGHT="50"><IMG SRC="/home/drake/Documents/github/ink-and-silence/mine/dossier/MBTI/media/starfire head flat,750x,075,f-pad,750x1000,f8f8f8.u2.jpg"/></TD></TR></TABLE>>
    ];    Strategist [label="Strategic Counterpart\n(Long-term Planning & Vision)"];
    Creative [label="Aesthetic Counterpart\n(Present Moment & Values)"];

    // INFP Archetype Candidates
    Barbie [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD FIXEDSIZE="TRUE" WIDTH="80" HEIGHT="50"><IMG SRC="/home/drake/Documents/github/ink-and-silence/mine/dossier/MBTI/media/INFP barbie.png"/></TD></TR></TABLE>>];
    Carrie [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD FIXEDSIZE="TRUE" WIDTH="80" HEIGHT="50"><IMG SRC="/home/drake/Documents/github/ink-and-silence/mine/dossier/MBTI/media/INFP carrie.png"/></TD></TR></TABLE>>];
    Coraline [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD FIXEDSIZE="TRUE" WIDTH="80" HEIGHT="50"><IMG SRC="/home/drake/Documents/github/ink-and-silence/mine/dossier/MBTI/media/INFP coraline.png"/></TD></TR></TABLE>>];
    Rapunzel [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD FIXEDSIZE="TRUE" WIDTH="80" HEIGHT="50"><IMG SRC="/home/drake/Documents/github/ink-and-silence/mine/dossier/MBTI/media/INFP rapunzel.png"/></TD></TR></TABLE>>];
    INFP_Unidentified1 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD FIXEDSIZE="TRUE" WIDTH="80" HEIGHT="50"><IMG SRC="/home/drake/Documents/github/ink-and-silence/mine/dossier/MBTI/media/INFP unidentified-1.png"/></TD></TR><TR><TD>?</TD></TR></TABLE>>];
    INFP_Unidentified2 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD FIXEDSIZE="TRUE" WIDTH="80" HEIGHT="50"><IMG SRC="/home/drake/Documents/github/ink-and-silence/mine/dossier/MBTI/media/INFP unidentified-2.png"/></TD></TR><TR><TD>?</TD></TR></TABLE>>];

    // ISFP Archetype Candidates (unidentified)
    ISFP_Unidentified1 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD FIXEDSIZE="TRUE" WIDTH="80" HEIGHT="50"><IMG SRC="/home/drake/Documents/github/ink-and-silence/mine/dossier/MBTI/media/ISFP unidentified-1.png"/></TD></TR><TR><TD>?</TD></TR></TABLE>>];
    ISFP_Unidentified2 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD FIXEDSIZE="TRUE" WIDTH="80" HEIGHT="50"><IMG SRC="/home/drake/Documents/github/ink-and-silence/mine/dossier/MBTI/media/ISFP unidentified-2.png"/></TD></TR><TR><TD>?</TD></TR></TABLE>>];
    ISFP_Unidentified3 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD FIXEDSIZE="TRUE" WIDTH="80" HEIGHT="50"><IMG SRC="/home/drake/Documents/github/ink-and-silence/mine/dossier/MBTI/media/ISFP unidentified-3.png"/></TD></TR><TR><TD>?</TD></TR></TABLE>>];
    ISFP_Unidentified4 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD FIXEDSIZE="TRUE" WIDTH="80" HEIGHT="50"><IMG SRC="/home/drake/Documents/github/ink-and-silence/mine/dossier/MBTI/media/ISFP unidentified-4.png"/></TD></TR><TR><TD>?</TD></TR></TABLE>>];

    // --- CONNECTION ARCHITECTURE ---

    // Left Layer to Middle Layer (Archetypes to MBTI)
    Starfire -> INFP [label=" XNFP Core Depth"];
    Barbie -> INFP [label=" Archetype Candidate"];
    Carrie -> INFP [label=" Archetype Candidate"];
    Coraline -> INFP [label=" Archetype Candidate"];
    Rapunzel -> INFP [label=" Archetype Candidate"];
    INFP_Unidentified1 -> INFP;
    INFP_Unidentified2 -> INFP;
    Analyst -> INTP [label=" Grounded Logic"];
    Strategist -> INTJ [label=" Shared Vision"];
    Creative -> ISFP [label=" Dual Function Stack"];
    ISFP_Unidentified1 -> ISFP;
    ISFP_Unidentified2 -> ISFP;
    ISFP_Unidentified3 -> ISFP;
    ISFP_Unidentified4 -> ISFP;

    // Middle Layer to Right Layer (MBTI to Target Hub)
    edge [weight=2, penwidth=1.5];
    
    INTP -> ENTJ [label="Ultimate Intellect\n(Allows ENTJ Lead)", color="#2980b9", fontcolor="#2980b9"];
    INFP -> ENTJ [label="Complementary Stack\n(Emotional Grounding)", color="#27ae60", fontcolor="#27ae60"];
    INTJ -> ENTJ [label="Strategic Alignment\n(Deep Conceptual)", color="#8e44ad", fontcolor="#8e44ad"];
    
    edge [style=dashed, penwidth=1.2];
    ISFP -> ENTJ [label="Socionics Duality\n(Accelerated Growth)", color="#e67e22", fontcolor="#e67e22"];

    // --- STRUCTURAL ALIGNMENT HINTS ---
    { rank=same; Starfire; Barbie; Carrie; Coraline; Rapunzel; INFP_Unidentified1; INFP_Unidentified2; Analyst; Strategist; Creative; ISFP_Unidentified1; ISFP_Unidentified2; ISFP_Unidentified3; ISFP_Unidentified4; }
    { rank=same; INTP; INFP; INTJ; ISFP; }
    { rank=max; ENTJ; }
}


